# ============================================================
# 环境变量配置示例：复制本文件为 .env 并填写真实值。
# .env 已被 .gitignore 忽略，不会进入版本库，用于存放 API Key 等敏感信息。
# 读取优先级：环境变量 > config.json > 内置默认值。
# ============================================================

# DeepSeek 兼容接口地址（默认已包含 /v1/chat/completions）
RPA_API_URL=https://api.deepseek.com/v1/chat/completions

# API 密钥（敏感信息，请勿提交到版本库）
RPA_API_KEY=

# 模型名称
RPA_MODEL=deepseek-chat

# 生成的脚本/EXE 默认文件名
RPA_SCRIPT_NAME=MyAutomation
